<Window x:Class="Explorf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorf Dashboard" 
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style x:Key="DarkPanel" TargetType="Border">
            <Setter Property="Background" Value="#18181E"/>
            <Setter Property="BorderBrush" Value="#2A2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="InnerContainer" TargetType="Border">
            <Setter Property="Background" Value="#121216"/>
            <Setter Property="BorderBrush" Value="#242430"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style x:Key="DarkPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D3B"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F52"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3A3A4C"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#52526A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#121216"/>
            <Setter Property="Foreground" Value="#9E9EA8"/>
            <Setter Property="BorderBrush" Value="#242430"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1C1C24"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E9A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#1E1E26"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DayCardButton" TargetType="Button">
            <Setter Property="Background" Value="#18181E"/>
            <Setter Property="Foreground" Value="#8E8E9A"/>
            <Setter Property="BorderBrush" Value="#2A2A36"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22222C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#454558"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CalTileButton" TargetType="Button">
            <Setter Property="Background" Value="#20202A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A38"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#2E2E3E"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#4A4A60"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardListViewItem" TargetType="ListViewItem">
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Background" Value="#121216"/>
            <Setter Property="BorderBrush" Value="#242430"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="cardBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cardBorder" Property="Background" Value="#1A1A22"/>
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#363646"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="#6366F1"/>
                                <Setter TargetName="cardBorder" Property="Background" Value="#1E1E2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorPickButton" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#3F3F52" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#0F0F13" CornerRadius="16" BorderBrush="#242430" BorderThickness="1">
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="4,4,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="24" Height="24" CornerRadius="6" Background="#2D2D3B" Margin="0,0,10,0">
                            <TextBlock Text="🌙" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Lunor / Explorf" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="MENU" Foreground="#525262" FontSize="10" FontWeight="Bold" Margin="8,0,0,8"/>

                    <Button x:Name="BtnNavDashboard" Click="NavDashboard_Click" Style="{StaticResource SidebarNavButton}" Margin="0,0,0,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞ " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Dashboard" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavCalendar" Click="NavCalendar_Click" Style="{StaticResource SidebarNavButton}" Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📅 " FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="Calendar &amp; Notes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="WORKSPACES" Foreground="#525262" FontSize="10" FontWeight="Bold" Margin="8,8,0,8"/>
                    <TextBlock Text="• Personal Focus" Foreground="#8E8E9A" FontSize="12" Margin="12,4,0,6"/>
                    <TextBlock Text="• Active Projects" Foreground="#8E8E9A" FontSize="12" Margin="12,0,0,6"/>
                    <TextBlock Text="• Home System" Foreground="#8E8E9A" FontSize="12" Margin="12,0,0,6"/>
                </StackPanel>

                <Border Grid.Row="2" Style="{StaticResource DarkPanel}" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Explorf System" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Автосохранение включено" Foreground="#71717A" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Button Content="Активный профиль" Style="{StaticResource DarkPrimaryButton}" Height="30"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- MAIN CONTENT -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Dashboard" Foreground="#8E8E9A" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text="Welcome back, User!" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="─" Click="BtnMinimize_Click" Foreground="#8E8E9A" Background="#18181E" BorderBrush="#2A2A36" BorderThickness="1" Width="32" Height="32" Margin="0,0,6,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="✕" Click="BtnClose_Click" Foreground="#8E8E9A" Background="#18181E" BorderBrush="#2A2A36" BorderThickness="1" Width="32" Height="32" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- METRICS -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DarkPanel}" Padding="14" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="Active Folders" Foreground="#8E8E9A" FontSize="11" FontWeight="Medium"/>
                            <TextBlock x:Name="TxtActiveFoldersCount" Text="0" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource DarkPanel}" Padding="14" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Focus Preset" Foreground="#8E8E9A" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="10 min" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DarkPanel}" Padding="14" Margin="4,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Total Sessions" Foreground="#8E8E9A" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="126" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Style="{StaticResource DarkPanel}" Padding="14" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="System Status" Foreground="#8E8E9A" FontSize="11" FontWeight="Medium"/>
                            <TextBlock Text="Online" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- VIEWS -->
                <Grid Grid.Row="2">
                    <!-- DASHBOARD -->
                    <Grid x:Name="ViewDashboard" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Понедельник" Margin="0,0,8,0" Content="Понедельник"/>
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Вторник" Margin="0,0,8,0" Content="Вторник"/>
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Среда" Margin="0,0,8,0" Content="Среда"/>
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Четверг" Margin="0,0,8,0" Content="Четверг"/>
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Пятница" Margin="0,0,8,0" Content="Пятница"/>
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Суббота" Margin="0,0,8,0" Content="Суббота"/>
                                <Button Style="{StaticResource DayCardButton}" Click="DayButton_Click" Tag="Воскресенье" Content="Воскресенье"/>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="380"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <Border Style="{StaticResource DarkPanel}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="FOCUS TIMER" Foreground="#8E8E9A" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <Button Content="5m" Style="{StaticResource DarkSecondaryButton}" Click="Preset_Click" Tag="5" Width="50" Margin="0,0,6,0"/>
                                            <Button Content="10m" Style="{StaticResource DarkSecondaryButton}" Click="Preset_Click" Tag="10" Width="50" Margin="0,0,6,0"/>
                                            <Button Content="15m" Style="{StaticResource DarkSecondaryButton}" Click="Preset_Click" Tag="15" Width="50"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource InnerContainer}" Padding="8" Margin="0,0,0,12">
                                            <TextBox x:Name="TxtTimerDisplay" Text="10:00" Foreground="#FFFFFF" Background="Transparent"
                                                     BorderThickness="0" FontSize="36" FontWeight="Bold" HorizontalContentAlignment="Center"
                                                     LostFocus="TxtTimerDisplay_LostFocus"/>
                                        </Border>
                                        <UniformGrid Columns="3">
                                            <Button x:Name="BtnStart" Content="Start" Click="BtnStart_Click" Style="{StaticResource DarkPrimaryButton}" Height="32" Margin="2"/>
                                            <Button x:Name="BtnPause" Content="Pause" Click="BtnPause_Click" Style="{StaticResource DarkSecondaryButton}" Height="32" Margin="2"/>
                                            <Button x:Name="BtnReset" Content="Reset" Click="BtnReset_Click" Style="{StaticResource DarkSecondaryButton}" Height="32" Margin="2"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource DarkPanel}" Padding="16">
                                    <Grid Height="220">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Text="WORK FOLDERS" Foreground="#8E8E9A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>

                                        <ListView Grid.Row="1" x:Name="FolderListView" Background="Transparent" BorderThickness="0"
                                                  ScrollViewer.CanContentScroll="False"
                                                  ItemContainerStyle="{StaticResource CardListViewItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" IsHitTestVisible="False"/>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Path}" Foreground="#71717A" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>

                                        <Grid Grid.Row="2" Margin="0,8,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                <Button Content="+" Click="BtnAddFolder_Click" Style="{StaticResource DarkSecondaryButton}" Width="30" Height="30" ToolTip="Добавить папку"/>
                                                <Button Content="🗑" Click="BtnRemoveFolder_Click" Style="{StaticResource DarkSecondaryButton}" Width="30" Height="30" Margin="4,0,0,0"/>
                                            </StackPanel>
                                            <Button Content="Open Selected" Click="BtnOpenFolders_Click" HorizontalAlignment="Right" Style="{StaticResource DarkPrimaryButton}" Padding="12,0" Height="30"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Style="{StaticResource DarkPanel}" Padding="20" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="SYSTEM TIME &amp; CLOCK" Foreground="#8E8E9A" FontSize="11" FontWeight="Bold"/>
                                            <TextBlock x:Name="TxtClockTime" Text="00:00:00" Foreground="#FFFFFF" FontSize="42" FontWeight="Bold" FontFamily="Consolas" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtClockDate" Text="Загрузка даты..." Foreground="#8E8E9A" FontSize="13" FontWeight="Medium" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource InnerContainer}" Padding="16" VerticalAlignment="Center">
                                            <StackPanel Width="160">
                                                <TextBlock Text="Статус среды" Foreground="#8E8E9A" FontSize="11"/>
                                                <TextBlock Text="🟢 Active Mode" Foreground="#10B981" FontWeight="Bold" FontSize="13" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Style="{StaticResource DarkPanel}" Padding="20">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                            <TextBlock x:Name="TxtWeekdayTitle" Text="ЗАМЕТКИ: ПОНЕДЕЛЬНИК" Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="Сохраняются автоматически для каждого дня недели" Foreground="#71717A" FontSize="11" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Row="1" Style="{StaticResource InnerContainer}" Padding="12">
                                            <TextBox x:Name="TxtWeekdayNote" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="13"
                                                     TextChanged="TxtWeekdayNote_TextChanged"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- CALENDAR VIEW -->
                    <Grid x:Name="ViewCalendar" Visibility="Collapsed">
                        <Border Style="{StaticResource DarkPanel}" Padding="24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="320"/>
                                    <ColumnDefinition Width="1"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#2D2D3B">
                                            <TextBlock Text="📅" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="Календарная Запись" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13"/>
                                            <TextBlock x:Name="TxtSelectedDateDisplay" Text="Выберите день..." Foreground="#71717A" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="Цветовая марка дня:" Foreground="#8E8E9A" FontSize="11" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <Button Style="{StaticResource ColorPickButton}" Background="#10B981" Click="ColorPick_Click" Tag="#10B981" ToolTip="Зеленый"/>
                                        <Button Style="{StaticResource ColorPickButton}" Background="#6366F1" Click="ColorPick_Click" Tag="#6366F1" ToolTip="Фиолетовый"/>
                                        <Button Style="{StaticResource ColorPickButton}" Background="#3B82F6" Click="ColorPick_Click" Tag="#3B82F6" ToolTip="Синий"/>
                                        <Button Style="{StaticResource ColorPickButton}" Background="#F59E0B" Click="ColorPick_Click" Tag="#F59E0B" ToolTip="Оранжевый"/>
                                        <Button Style="{StaticResource ColorPickButton}" Background="#EF4444" Click="ColorPick_Click" Tag="#EF4444" ToolTip="Красный"/>
                                        <Button Content="✕" Foreground="#8E8E9A" FontSize="10" Style="{StaticResource ColorPickButton}" Background="#22222E" Click="ColorPick_Click" Tag="CLEAR" ToolTip="Сбросить цвет"/>
                                    </StackPanel>

                                    <Border Height="1" Background="#242430" Margin="0,0,0,16"/>

                                    <TextBlock Text="Текст события / Заметка:" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,8"/>
                                    <Border Style="{StaticResource InnerContainer}" Padding="10" Height="220">
                                        <TextBox x:Name="TxtCalendarDayNote" Background="Transparent" Foreground="#FFFFFF" BorderThickness="0"
                                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="12"
                                                 TextChanged="TxtCalendarDayNote_TextChanged"/>
                                    </Border>
                                </StackPanel>

                                <Rectangle Grid.Column="1" Fill="#242430" Width="1" HorizontalAlignment="Center"/>

                                <Grid Grid.Column="2" Margin="24,0,0,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <TextBlock x:Name="TxtMonthYearHeader" Text="Месяц Год" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="‹" Click="BtnPrevMonth_Click" Style="{StaticResource DarkSecondaryButton}" Width="32" Height="32" FontSize="16" Margin="0,0,6,0"/>
                                            <Button Content="›" Click="BtnNextMonth_Click" Style="{StaticResource DarkSecondaryButton}" Width="32" Height="32" FontSize="16"/>
                                        </StackPanel>
                                    </Grid>

                                    <UniformGrid Grid.Row="1" Columns="7" Margin="0,0,0,12">
                                        <TextBlock Text="ПН" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ВТ" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="СР" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ЧТ" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ПТ" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="СБ" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="ВС" Foreground="#646473" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </UniformGrid>

                                    <UniformGrid Grid.Row="2" x:Name="CalendarGrid" Rows="6" Columns="7"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>